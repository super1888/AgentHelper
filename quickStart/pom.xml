<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.spring.ai</groupId>
        <artifactId>springAi</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>quickStart</artifactId>
    <packaging>jar</packaging>
    <description>startup module</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.alibaba.nacos</groupId>
                    <artifactId>nacos-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.alibaba.nacos</groupId>
                    <artifactId>nacos-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>logging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>interceptors</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>hooks</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>tools</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>prompt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>vectorStore</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>skills</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>a2a</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spring.ai</groupId>
            <artifactId>opencv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>ai.djl.pytorch</groupId>
            <artifactId>pytorch-jni</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>ai.djl.pytorch</groupId>
            <artifactId>pytorch-native-cpu</artifactId>
            <classifier>${face.djl.classifier}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <classifier>${face.javacv.classifier}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <classifier>${face.javacv.classifier}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <classifier>${face.javacv.classifier}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <classifier>${face.javacv.classifier}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>cn.smartjavaai</groupId>
            <artifactId>smartjavaai-face</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>cn.smartjavaai</groupId>
            <artifactId>smartjavaai-common</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
